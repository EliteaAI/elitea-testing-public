# Elitea Test Automation — Environment Configuration
# Copy this file to .env.test and fill in your values.
#
# Target environment — the automation factory analyses and builds tests against
# the DEV env (deployed UI, /app prefix). Agents browse it through the Playwright
# MCP with the storage state written by `scripts/dev_storage_state.py`.
ELITEA_URL=https://dev.elitea.ai
APP_PREFIX=/app
ELITEA_API_BASE=https://dev.elitea.ai/api/v2

# Other deployed envs (CI targets): same shape, /app prefix
# ELITEA_URL=https://next.elitea.ai
# ELITEA_API_BASE=https://next.elitea.ai/api/v2

# Local UI (Vite dev server, EliteaUI automation/testids) — testid MIGRATOR ONLY
# (phase B: verify freshly added testids before they deploy). APP_PREFIX is empty
# and auth is skipped (VITE_DEV_TOKEN). Never the factory's target.
# ELITEA_URL=http://localhost:5173
# APP_PREFIX=

ELITEA_PROJECT_ID=<your_project_id>

# Keycloak credentials (use username, NOT email)
TEST_USER_EMAIL=<keycloak_username>
TEST_USER_PASSWORD=<keycloak_password>

# Elitea API token (generated in Settings → API Keys)
ELITEA_API_TOKEN=<your_api_token>

# Browser options
HEADLESS=false
# Set to true to record Playwright traces for failed tests (saved to reports/traces/)
PLAYWRIGHT_TRACES=false

# Toolkit tokens — tests that require these will auto-skip if not set
# GITHUB_TOKEN=ghp_...
# JIRA_API_KEY=...
# JIRA_BASE_URL=https://your-org.atlassian.net
# JIRA_USERNAME=...

