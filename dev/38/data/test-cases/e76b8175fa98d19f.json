l\n    7. Click Reload\n    8. Verify after fix:\n       - Status indicator gone\n       - Warning message gone\n       - Reload button gone\n       - Open in new tab remains\n       - Save button enabled\n</code></pre>\n","status":"failed","statusMessage":"AssertionError: Expected status indicator for invalid credential\nassert False\n +  where False = has_credential_status_indicator(timeout=15000)\n +    where has_credential_status_indicator = <pages.toolkit_detail_page.ToolkitDetailPage object at 0x7faee2aa43d0>.has_credential_status_indicator","statusTrace":"tests/ui/toolkits/test_toolkit_indicators_for_credentials.py:123: in test_toolkit_credential_indicators_e2e\n    assert toolkit_page.has_credential_status_indicator(timeout=15000), (\nE   AssertionError: Expected status indicator for invalid credential\nE   assert False\nE    +  where False = has_credential_status_indicator(timeout=15000)\nE    +    where has_credential_status_indicator = <pages.toolkit_detail_page.ToolkitDetailPage object at 0x7faee2aa43d0>.has_credential_status_indicator","flaky":false,"newFailed":false,"newBroken":false,"newPassed":false,"retriesCount":0,"retriesStatusChange":false,"beforeStages":[{"name":"base_url","time":{"start":1782742183565,"stop":1782742183565,"duration":0},"status":"passed","steps":[],"attachments":[],"parameters":[],"shouldDisplayMessage":false,"stepsCount":0,"attachmentsCount":0,"hasContent":false,"attachmentStep":false},{"name":"pytestconfig","time":{"start":1782742183565,"stop":1782742183565,"duration":0},"status":"passed","steps":[],"attachments":[],"parameters":[],"shouldDisplayMessage":false,"stepsCount":0,"attachmentsCount":0,"hasContent":false,"attachmentStep":false},{"name":"_verify_url","time":{"start":1782742183565,"stop":1782742183565,"duration":0},"status":"passed","steps":[],"attachments":[],"parameters":[],"shouldDisplayMessage":false,"stepsCount":0,"attachmentsCount":0,"hasContent":false,"attachmentStep":false},{"name":"delete_output_dir","time":{"