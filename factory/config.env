# config.env — the only file with project-specific values in it.
# Everything here is a fact; behavior lives in the loop prompts and the seed.

# Where tracking lives (issues + project board). NOT the work repo.
TRACKING_REPO="EliteaAI/elitea-testing-public"

# The Projects v2 board attached to that repo.
PROJECT_OWNER="EliteaAI"          # org or user that owns the project
PROJECT_NUMBER="9"

# The four column names the loop READS — a translation table to YOUR board,
# nothing more. This is the minimum state machine the loop can act on:
# may-start / started / needs-a-human / finished. (Backlog is deliberately
# absent: the loop never touches it.) If your columns use these exact names,
# leave this block alone.
STATUS_READY="Approved"           # the trigger: queue = cards here
STATUS_ACTIVE="In Progress"      # also claimable (a dead session must be retryable)
STATUS_BLOCKED="Blocked"          # parked = good outcome; also the escalation target
STATUS_DONE="Done"                # success — else finished work would read as a stall


# Child issues (questions, bug reports) are conversation places, never tasks.
# Loops refuse cards carrying these labels even if someone drags one to
# Approved by mistake.
CHILD_LABELS="question bug"

# Permission mode for factory sessions. Unattended sessions cannot click
# "approve", so anything gated (gh, git, npx, curl) dead-ends the whole run —
# proven on the first live attempt. bypassPermissions removes the wall for
# the FACTORY sessions only; interactive sessions keep their normal prompts.
# The real guards are elsewhere: Approved-only trigger, gh pr checks before
# merge, and (recommended) branch protection on main.
PERMISSION_MODE="bypassPermissions"

# Safety caps
MAX_ATTEMPTS=3
# MAX_TURNS: empty = unlimited (a real case can legitimately need many turns).
# CAUTION: this was the only hard cap on a runaway session — with it empty,
# a stuck session runs until you Ctrl-C (attempts only bound BETWEEN
# sessions). Set a number here, or per loop in loops/<name>.env, to cap.
MAX_TURNS=""
