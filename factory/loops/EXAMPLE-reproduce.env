# Loop "reproduce" — Sage (qa-engineer) reproduces reported bugs on DEV.
# Card-driven: triggers on each `bug` card in Todo not yet processed. The agent
# stamps a verdict label + the terminal `repro:triaged` (control-loop pattern) —
# the LABEL, not a card move, is what takes a card out of this queue.
AGENT="qa-engineer"
STATUS_READY="Todo"                        # trigger column: where bug cards land
QUERY="label:bug -label:repro:triaged"     # ALL bugs, minus already-processed.
                                           # repro:triaged is the terminal dequeue
                                           # marker the agent stamps on exit.
SID_SCOPE="reproduce"                      # own conversation namespace (card-driven)
CHILD_LABELS="question"                    # parked-decision issues this loop may file
POLL="30m"                                 # bugs arrive rarely — check less often
MAX_TURNS=""                               # optional cap, as everywhere
# No overlap with tal: tal triggers on Approved (its STATUS_READY default) and the
# load-bearing `bug` label keeps bugs out of the automation pipeline entirely. This
# loop is the ONLY consumer of `label:bug` on Todo. If you ever point tal at Todo,
# exclude bugs there: QUERY="-label:bug".
# EXCLUSIVE not needed: reads bug cards, writes only labels + comments + drives the
# browser (Playwright MCP) — never touches the git working tree.
# WORKDIR not needed: no working-tree writes.
