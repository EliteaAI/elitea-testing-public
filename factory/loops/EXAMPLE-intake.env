# Example CARDLESS loop: no board card drives it — it scans a source on a
# cadence and files cards. Rename to intake.env + intake.md to activate.
AGENT="test-automation-lead"
CARDLESS=1
QUERY=""            # unused in cardless mode
POLL="24h"           # tick cadence; unset = one tick per invocation
MAX_TURNS=""        # optional cap, as everywhere
WORKDIR="/opt/work_dir/elitea-testing-public"   # MANDATORY for every loop: the
                    # harness ships no .claude/.agents, so skills, agents, rules,
                    # hooks and doctrine only exist in the work repo's checkout.
