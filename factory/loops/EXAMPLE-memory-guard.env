# Cardless housekeeping: keeps every role's MEMORY.md under the size that
# survives the SessionStart/SubagentStart hook's 10,000-char additionalContext
# cap (role memory = MEMORY.md + project_briefing.md [+ snapshot.md],
# concatenated into ONE hook payload — collect_role_memory() in
# .claude/hooks/sdlc-skills/lib.sh). Mirrors Claude Code's own native
# auto-memory guard (200-line/25KB nudge-and-enforce), which only governs ITS
# OWN memory path (~/.claude/projects/<project>/memory/MEMORY.md), not this
# project's .agents/memory/<role>/ convention — nothing wires the two
# together, so this loop is the substitute.
AGENT="scout"
CARDLESS=1
EXCLUSIVE=1           # this loop rewrites OTHER roles' memory files — must
                      # never run alongside a live session that might be
                      # appending to the same MEMORY.md at the same time
                      # (this team has 3 already-recorded concurrent-memory-
                      # write incidents; see test-automation-lead's own
                      # memory on shared-tree/memory clobbering)
POLL="24h"            # nightly sweep; empty queue (nothing over budget) just
                      # ticks again at this cadence
MAX_TURNS=""
