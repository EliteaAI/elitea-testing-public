# Example CARDLESS loop: periodic branch sync (merge-only) — automation/factory ← main
# in the test repo. EliteaUI / elitea_assistant automation/testids are the testid-migrator's.
# Rename to syncbranch.env + syncbranch.md to activate: ./factory/run.sh syncbranch
AGENT="test-automation-lead"
CARDLESS=1
EXCLUSIVE=1                  # this loop waits until all other loops are idle,
                               # then blocks them while each of its sessions runs
QUERY=""            # unused in cardless mode
POLL="12h"           # tick cadence; unset = one tick per invocation
MAX_TURNS=""        # optional cap, as everywhere
WORKDIR="/opt/work_dir/elitea-testing-public"   # the clone whose automation/factory it syncs
