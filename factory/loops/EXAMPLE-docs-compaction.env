# Example CARDLESS loop: proposes a dedup pass over the shared `.agents/*`
# docs (`@`-imported into every session's root CLAUDE.md — see its "Team &
# Way of Work" section) as a DRAFT PR for human review. Never commits
# directly to automation/base, never merges its own PR — mirrors the
# `control` loop's verdict-only precedent, applied to docs instead of cards.
# Exists because these docs are now loaded in full on EVERY session and
# EVERY dispatched subagent (uncapped @import, ~82KB combined as of
# 2026-07-23) — unlike role memory, there's no hard cap forcing this, it's
# a cost optimization a human should approve, not an unattended commit.
# Rename to docs-compaction.env + docs-compaction.md to activate:
# ./factory/run.sh docs-compaction
AGENT="scout"
CARDLESS=1
EXCLUSIVE=1          # edits the same shared docs every other session relies
                     # on and opens a PR — run with nothing else concurrently
                     # touching .agents/ or the tracker repo's PR list
POLL="168h"          # weekly — these docs move slowly; no need for a nightly
                     # tick. Unset (or --once) for a single manual run.
MAX_TURNS=""
