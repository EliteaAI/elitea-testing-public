# Example CARDLESS loop: weekly locator → testid migration (testid-migrator, "Tess").
# STAGED — run it manually (`claude --agent testid-migrator "Weekly migration run — limit 25"`)
# until the pilot run has been reviewed. To activate, rename to testid-migrator.env +
# testid-migrator.md and run: ./factory/run.sh testid-migrator
AGENT="testid-migrator"
CARDLESS=1
EXCLUSIVE=1                  # phase B moves the shared ../EliteaUI tree (dev server on
                               # automation/testids) — no other loop may run beside it
QUERY=""            # unused in cardless mode
POLL="168h"         # weekly
MAX_TURNS=""        # optional cap, as everywhere
