# Loop "tal" — the default: Tal works Approved cases.
AGENT="test-automation-lead"
QUERY=""                       # extra Projects-filter terms ANDed onto every
                               # queue read. EMPTY = CATCH-ALL: every card in
                               # the trigger column is Tal's — including cards
                               # meant for specialized loops! When you add a
                               # loop with QUERY="label:repro", exclude it here:
                               # QUERY="-label:repro" (negation verified).
# STATUS_READY="Approved"      # per-loop trigger column override — react to a
                               # different board column than the default.
# EXCLUSIVE=1                  # this loop waits until all other loops are idle,
                               # then blocks them while each of its sessions runs
                               # (for work that must not run in parallel).
POLL="5m"                      # empty queue → re-check at this cadence (30s/5m/1h);
                               # unset/empty = stop when the queue is empty
# WORKDIR=""                   # optional: separate clone if several WRITING loops
                               # run at once (two agents editing one working tree
                               # collide in git; readers don't need this)
