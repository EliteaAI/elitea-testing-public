 min/max range validation (100-4096 — Yup\n    schema ``profileValidationSchema.summary_llm_settings.max_tokens`` in\n    ``src/[fsd]/features/settings/lib/helpers/profile.helpers.js``,\n    limits sourced from ``VALIDATION_LIMITS.MAX_TOKENS`` in\n    ``src/[fsd]/widgets/context-budget/lib/constants.js``): an out-of-range\n    value flips ``aria-invalid=&quot;true&quot;`` and BLOCKS the autosave submit\n    (``useFormikAutoSaveOnBlur`` calls ``validateForm()`` before\n    ``submitForm()`` and returns early on errors); an in-range value\n    autosaves normally.\n\n    AFS: test-specs/settings-user-profile/\n    lextend_target-summary-tokens-range-validation_ELITEA-2378.md\n</code></pre>\n","status":"passed","flaky":false,"newFailed":false,"newBroken":false,"newPassed":false,"retriesCount":0,"retriesStatusChange":false,"beforeStages":[{"name":"pytestconfig","time":{"start":1787309707984,"stop":1787309707984,"duration":0},"status":"passed","steps":[],"attachments":[],"parameters":[],"shouldDisplayMessage":false,"stepsCount":0,"attachmentsCount":0,"hasContent":false,"attachmentStep":false},{"name":"base_url","time":{"start":1787309707984,"stop":1787309707984,"duration":0},"status":"passed","steps":[],"attachments":[],"parameters":[],"shouldDisplayMessage":false,"stepsCount":0,"attachmentsCount":0,"hasContent":false,"attachmentStep":false},{"name":"_verify_url","time":{"start":1787309707984,"stop":1787309707984,"duration":0},"status":"passed","steps":[],"attachments":[],"parameters":[],"shouldDisplayMessage":false,"stepsCount":0,"attachmentsCount":0,"hasContent":false,"attachmentStep":false},{"name":"browser","time":{"start":1787309707984,"stop":1787309709983,"duration":1999},"status":"passed","steps":[],"attachments":[],"parameters":[],"shouldDisplayMessage":false,"stepsCount":0,"attachmentsCount":0,"hasContent":false,"attachmentStep":false},{"name":"delete_output_dir","time":{"start":1787309707984,"stop":1787309707984,"duration":0},"status":"passed","steps":[],"attachm